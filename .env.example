# Copy this file to .env and fill in your own values once you wire up a backend.
# Until these are set, the app runs standalone with browser localStorage and a
# mock (non-production) auth layer — see the AUTH section at the top of src/App.jsx.

# Supabase — auth + the relational ledger schema (supabase/migrations/0001_init.sql)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI proxy (api/claude.js) — server-only, never sent to the browser.
# GEMINI_API_KEY: free tier, default provider. Get one at https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY: optional, better quality, used when a user switches to
#   "Claude (Pro)" in Setup. Get one at https://console.anthropic.com
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# AdSense (optional — leave blank while testing)
VITE_ADSENSE_CLIENT=
