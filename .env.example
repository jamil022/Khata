# Copy this file to .env and fill in your own values once you wire up a backend.
# Until these are set, the app runs standalone with browser localStorage and a
# mock (non-production) auth layer — see the AUTH section at the top of src/App.jsx.

# Supabase (recommended path — see README "Backend" section)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AdSense (optional — leave blank while testing)
VITE_ADSENSE_CLIENT=
